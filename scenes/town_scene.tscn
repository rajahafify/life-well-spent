[node name="Shopkeeper" parent="." instance=ExtResource("3_npc")]
position = Vector2(512, 1140)
scale = Vector2(2, 2)
display_name = "Shopkeeper"
talk_radius = 140.0
solid_radius = 40.0
talk_stop_buffer = 60.0
role = "shopkeeper"
dialog_text = "Welcome, traveler.\n\nThis shop once packed bags for heroes.\nNow I sell apples, candles, and thread.\n\nIt is quieter, yes.\nBut quiet days are worth protecting too."

[node name="Sprite" parent="Shopkeeper"]
texture = ExtResource("6_shopkeeper")
idle_cycle_interval = 0.92

[node name="Guildmaster" parent="." instance=ExtResource("3_npc")]
position = Vector2(960, 450)
scale = Vector2(2, 2)
display_name = "Guildmaster"
talk_radius = 140.0
solid_radius = 40.0
talk_stop_buffer = 60.0
role = "guildmaster"
dialog_text = "The Swordsman Guild still stands.\n\nNot as it was.\nThe halls are quiet, and the old names fade from the register.\n\nBut a guild is not stone or banners.\nIt lives when someone chooses the path.\n\nPerhaps one day, someone will help me raise it again."

[node name="Sprite" parent="Guildmaster"]
texture = ExtResource("5_guildmaster")
idle_cycle_interval = 1.1

[node name="Smith" parent="." instance=ExtResource("3_npc")]
position = Vector2(1472, 820)
scale = Vector2(2, 2)
display_name = "Smith"
talk_radius = 140.0
solid_radius = 40.0
talk_stop_buffer = 60.0
role = "smith"
dialog_text = "I used to shape steel for adventurers.\n\nNow I mend plows, hinges, and cooking pots.\nHonest work.\n\nStill, I keep the sword molds clean.\nOld roads have a way of calling again."

[node name="Sprite" parent="Smith"]
